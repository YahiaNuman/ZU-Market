@model DashboardViewModel
@{ ViewData["Title"] = L["Dashboard"]; }
<div class="page-header compact"><div class="container"><span class="eyebrow">@L["StudentDashboard"]</span><h1>@L["HelloUser", Model.User.FullName]</h1><p>@L["DashboardText"]</p></div></div><div class="container section"><div class="verification-banner verification-@Model.User.VerificationStatus.ToString().ToLowerInvariant()"><div><strong>@L[$"Verification{Model.User.VerificationStatus}"]</strong><p>@L[$"Verification{Model.User.VerificationStatus}Text"]</p></div><a class="btn btn-light" asp-controller="Verification" asp-action="Index">@L["ViewVerification"]</a></div><div class="stats-grid"><a asp-controller="Listings" asp-action="My"><strong>@Model.Listings.Count</strong><span>@L["MyListings"]</span></a><a asp-controller="Listings" asp-action="Favorites"><strong>@Model.Favorites</strong><span>@L["Favorites"]</span></a><a asp-controller="Messages" asp-action="Index"><strong>@Model.Conversations</strong><span>@L["Messages"]</span></a></div><div class="section-heading"><h2>@L["RecentOwnListings"]</h2><a asp-controller="Listings" asp-action="My">@L["ViewAll"]</a></div>@if(Model.Listings.Count==0){<div class="empty-state"><h3>@L["NoOwnListings"]</h3><a class="btn btn-primary" asp-controller="Listings" asp-action="Create">@L["CreateListing"]</a></div>}else{<div class="listing-grid">@foreach(var item in Model.Listings){<partial name="_ListingCard" model="item" />}</div>}</div>
