@model ForgotPasswordViewModel
@{ ViewData["Title"] = L["ForgotPassword"]; }
<div class="container page-narrow"><div class="form-heading"><h1>@L["ForgotPassword"]</h1><p>@L["ForgotPasswordText"]</p></div><form method="post" class="form-card"><div class="field"><label asp-for="Email">@L["Email"]</label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span></div><button class="btn btn-primary w-100" type="submit">@L["SendResetLink"]</button>@if(TempData["DevelopmentResetUrl"] is string url){<div class="development-note"><strong>@L["DevelopmentOnly"]</strong><p>@L["DevelopmentResetText"]</p><a href="@url">@L["OpenResetPage"]</a></div>}</form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
