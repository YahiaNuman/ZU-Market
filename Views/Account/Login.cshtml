@model LoginViewModel
@{ ViewData["Title"] = L["Login"]; }
<div class="auth-shell"><div class="auth-aside"><a class="auth-brand" asp-controller="Home" asp-action="Index"><img src="~/images/brand/zu-market-logo.png" alt="@L["BrandLogoAlt"]" /></a><div><h2>@L["WelcomeBackAside"]</h2><p>@L["WelcomeBackAsideText"]</p></div></div><div class="auth-main"><div class="auth-card"><h1>@L["WelcomeBack"]</h1><p>@L["LoginText"]</p><form method="post"><input type="hidden" asp-for="ReturnUrl" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="field"><label asp-for="Email">@L["Email"]</label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="Password">@L["Password"]</label><input asp-for="Password" autocomplete="current-password" /><span asp-validation-for="Password"></span></div><div class="form-between"><label class="check-label"><input asp-for="RememberMe" /> @L["RememberMe"]</label><a asp-action="ForgotPassword">@L["ForgotPassword"]</a></div><button class="btn btn-primary btn-lg w-100" type="submit">@L["Login"]</button></form><p class="auth-switch">@L["NoAccount"] <a asp-action="Register">@L["CreateAccount"]</a></p></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
