@model ResetPasswordViewModel
@{ ViewData["Title"] = L["ResetPassword"]; }
<div class="container page-narrow"><div class="form-heading"><h1>@L["ResetPassword"]</h1><p>@L["ResetPasswordText"]</p></div><form method="post" class="form-card"><input type="hidden" asp-for="Email" /><input type="hidden" asp-for="Token" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="field"><label asp-for="Password">@L["NewPassword"]</label><input asp-for="Password" autocomplete="new-password" /></div><div class="field"><label asp-for="ConfirmPassword">@L["ConfirmPassword"]</label><input asp-for="ConfirmPassword" autocomplete="new-password" /></div><button class="btn btn-primary w-100" type="submit">@L["ResetPassword"]</button></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
