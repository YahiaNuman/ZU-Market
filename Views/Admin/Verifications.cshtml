@model IReadOnlyList<VerificationRequest>
@{ ViewData["Title"] = L["ReviewVerifications"]; }
<div class="container section"><div class="section-heading"><h1>@L["ReviewVerifications"]</h1></div><div class="table-wrap"><table><thead><tr><th>@L["Student"]</th><th>@L["UniversityId"]</th><th>@L["Submitted"]</th><th>@L["Status"]</th><th>@L["Actions"]</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.User!.FullName<br/><small>@item.User.Email</small></td><td>@item.User.UniversityId</td><td>@item.SubmittedAtUtc.ToLocalTime().ToString("g")</td><td><span class="status-badge status-@item.Status.ToString().ToLowerInvariant()">@L[item.Status.ToString()]</span></td><td><a class="btn btn-sm btn-outline-primary" asp-action="VerificationDetails" asp-route-id="@item.Id">@L["Review"]</a></td></tr>}</tbody></table></div></div>
