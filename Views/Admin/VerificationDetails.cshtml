@model VerificationRequest
@{ ViewData["Title"] = L["VerificationDetails"]; }
<div class="container section page-narrow"><div class="section-heading"><h1>@L["VerificationDetails"]</h1></div><div class="review-card"><dl><div><dt>@L["FullName"]</dt><dd>@Model.User!.FullName</dd></div><div><dt>@L["UniversityId"]</dt><dd>@(Model.User.UniversityId ?? L["NotApplicable"].Value)</dd></div><div><dt>@L["College"]</dt><dd>@(Model.User.College ?? L["NotApplicable"].Value)</dd></div><div><dt>@L["Email"]</dt><dd>@Model.User.Email</dd></div></dl><img class="document-review" src="@Url.Action("Document","Verification",new{id=Model.Id})" alt="@L["UniversityIdDocument"]" />@if(Model.Status==VerificationStatus.Pending){<form asp-action="ReviewVerification" method="post"><input type="hidden" name="id" value="@Model.Id" /><div class="field"><label for="notes">@L["ReviewNotes"]</label><textarea id="notes" name="notes" rows="4"></textarea></div><div class="button-row"><button class="btn btn-success" name="approve" value="true" type="submit">@L["Approve"]</button><button class="btn btn-danger" name="approve" value="false" type="submit">@L["Reject"]</button></div></form>}</div></div>
