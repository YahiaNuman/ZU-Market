@model IReadOnlyList<ApplicationUser>
@{ ViewData["Title"] = L["ManageUsers"]; var admins = (HashSet<string>)ViewBag.AdminIds; }
<div class="container section"><div class="section-heading"><h1>@L["ManageUsers"]</h1></div><div class="table-wrap"><table><thead><tr><th>@L["Student"]</th><th>@L["UniversityId"]</th><th>@L["Verification"]</th><th>@L["Role"]</th><th>@L["AccountStatus"]</th><th>@L["Actions"]</th></tr></thead><tbody>@foreach(var item in Model){var isAdmin=admins.Contains(item.Id);<tr><td>@item.FullName<br/><small>@item.Email</small></td><td>@(string.IsNullOrWhiteSpace(item.UniversityId)?L["NotApplicable"]:item.UniversityId)</td><td>@L[item.VerificationStatus.ToString()]</td><td>@(isAdmin?L["Admin"]:L["User"])</td><td>@(item.IsDisabled?L["Disabled"]:L["Active"])</td><td><div class="button-row"><form asp-action="ToggleUser" method="post"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm @(item.IsDisabled?"btn-success":"btn-outline-danger")" type="submit">@(item.IsDisabled?L["Enable"]:L["Disable"])</button></form><form asp-action="ToggleAdmin" method="post"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-primary" type="submit" data-confirm="@L["ConfirmRoleChange"]">@(isAdmin?L["RevokeAdmin"]:L["GrantAdmin"])</button></form></div></td></tr>}</tbody></table></div></div>
