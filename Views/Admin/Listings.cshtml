@model IReadOnlyList<Listing>
@using ZuMarket.Services
@{ ViewData["Title"] = L["ModerateListings"]; }
<div class="container section">
    <div class="section-heading"><h1>@L["ModerateListings"]</h1><div class="tabs"><a asp-route-status="Pending">@L["Pending"]</a><a asp-route-status="Approved">@L["Approved"]</a><a asp-route-status="Rejected">@L["Rejected"]</a><a asp-route-status="Hidden">@L["Hidden"]</a></div></div>
    @if (Model.Count == 0)
    {
        <div class="empty-state"><h2>@L["NothingToReview"]</h2></div>
    }
    else
    {
        <div class="moderation-grid">
            @foreach (var item in Model)
            {
                var ai = item.AiReviews.OrderByDescending(x => x.CreatedAtUtc).FirstOrDefault();
                <article class="review-card">
                    <div class="review-listing"><div>@if (item.Images.Any()) { <img src="@Url.Action("Image", "Listings", new { id = item.Images.First().Id })" alt="@item.Title" /> }</div><div><span>@L[item.Category!.Key]</span><h2><a asp-controller="Listings" asp-action="Details" asp-route-id="@item.Id">@item.Title</a></h2><p>@item.Seller!.FullName</p><span class="status-badge status-@item.ReviewState.ToString().ToLowerInvariant()">@L[$"ReviewState_{item.ReviewState}"]</span></div></div>
                    @if (ai is not null)
                    {
                        <details class="ai-review-box"><summary>@L["AiReviewResult"] · @L[$"AiReviewDecision_{ai.Decision}"] · @ai.Confidence.ToString("P0")</summary><p>@ai.Explanation</p><ul class="ai-rule-checks">@foreach (var check in System.Text.Json.JsonSerializer.Deserialize<List<AiRuleCheck>>(ai.RuleChecksJson) ?? new List<AiRuleCheck>()) { <li><span>@L[$"AiRule_{check.Rule}"]</span><strong>@L[check.Passed ? "RulePassed" : "RuleFailed"]</strong></li> }</ul><small>@ai.Provider · @ai.Model · @ai.CreatedAtUtc.ToLocalTime().ToString("g")</small></details>
                    }
                    <form asp-action="ReviewListing" method="post"><input type="hidden" name="id" value="@item.Id" /><div class="field"><label>@L["ModerationNotes"]</label><textarea name="notes" rows="2">@item.ModerationNotes</textarea></div><div class="button-row"><button class="btn btn-success btn-sm" name="status" value="Approved">@L["Approve"]</button><button class="btn btn-danger btn-sm" name="status" value="Rejected">@L["Reject"]</button><button class="btn btn-outline-primary btn-sm" name="status" value="Hidden">@L["Hide"]</button><button class="btn btn-outline-danger btn-sm" name="status" value="Removed">@L["Remove"]</button></div></form>
                </article>
            }
        </div>
    }
</div>
