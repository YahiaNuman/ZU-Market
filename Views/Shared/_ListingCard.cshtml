@model Listing
@{
    var displayTitle = Model.DisplayTitle(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName);
    var isFree = Model.IsFree || Model.Price == 0;
}
<article class="listing-card">
    <a class="listing-image" asp-controller="Listings" asp-action="Details" asp-route-id="@Model.Id">
        @if (Model.Images.Any()) { <img src="@Url.Action("Image", "Listings", new { id = Model.Images.OrderBy(x => x.SortOrder).First().Id })" alt="@displayTitle" loading="lazy" /> }
        else { <span class="image-placeholder" aria-hidden="true"></span> }
    </a>
    <p class="listing-price@(isFree ? " is-free" : "")">@(isFree ? L["Free"].Value : $"{Model.Price:0.##} {L["JOD"]}")</p>
    <h3 dir="auto"><a asp-controller="Listings" asp-action="Details" asp-route-id="@Model.Id">@displayTitle</a></h3>
</article>
