@model ErrorViewModel
@{ ViewData["Title"] = L["Error"]; }
<div class="container"><div class="empty-state page-state"><span class="status-code">!</span><h1>@L["ErrorTitle"]</h1><p>@L["ErrorText"]</p>@if (Model.ShowRequestId) { <p><small>@L["RequestId"] @Model.RequestId</small></p> }<a class="btn btn-primary" asp-controller="Home" asp-action="Index">@L["BackHome"]</a></div></div>
