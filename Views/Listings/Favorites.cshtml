@model IReadOnlyList<Favorite>
@{ ViewData["Title"] = L["Favorites"]; }
<div class="container section"><div class="section-heading"><div><h1>@L["Favorites"]</h1><p>@L["FavoritesText"]</p></div></div>@if(Model.Count==0){<div class="empty-state"><h2>@L["NoFavorites"]</h2><p>@L["NoFavoritesText"]</p><a class="btn btn-primary" asp-action="Index">@L["BrowseListings"]</a></div>}else{<div class="listing-grid">@foreach(var favorite in Model){<partial name="_ListingCard" model="favorite.Listing!" />}}</div>}</div>
