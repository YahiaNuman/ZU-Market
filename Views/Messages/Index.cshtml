@model IReadOnlyList<ConversationSummaryViewModel>
@{ ViewData["Title"] = L["Messages"]; }
<div class="container section page-narrow">
    <div class="section-heading"><div><h1>@L["Messages"]</h1><p>@L["MessagesText"]</p></div></div>
    @if (Model.Count == 0)
    {
        <div class="empty-state"><h2>@L["NoConversations"]</h2><p>@L["NoConversationsText"]</p><a class="btn btn-primary" asp-controller="Listings" asp-action="Index">@L["BrowseListings"]</a></div>
    }
    else
    {
        <div class="conversation-list">
            @foreach (var item in Model)
            {
                <a class="@(item.UnreadCount > 0 ? "unread" : "")" asp-action="Details" asp-route-id="@item.Id">
                    <span class="avatar">@item.OtherParticipantName[0]</span>
                    <div><strong>@item.OtherParticipantName</strong><span class="conversation-listing">@item.ListingTitle</span><span class="conversation-preview">@(string.IsNullOrWhiteSpace(item.LatestMessage) ? L["NoMessagesYet"].Value : item.LatestMessage)</span></div>
                    <aside>
                        @if (item.UnreadCount > 0) { <span class="unread-count" aria-label="@L["UnreadMessages", item.UnreadCount]">@item.UnreadCount</span> }
                        <time>@item.LastMessageAtUtc.ToLocalTime().ToString("g")</time>
                    </aside>
                </a>
            }
        </div>
    }
</div>
