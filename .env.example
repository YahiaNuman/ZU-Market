# Optional. The Docker stack runs without a .env file.
# To change anything, copy this file to .env (which git ignores) and edit it.

# Turns on the AI features: listing review, auto-fill from photo, translation and
# report summaries. Each teammate uses their own key. Never commit a real key.
OPENAI_API_KEY=

# Change these if the ports are already in use on your laptop.
WEB_PORT=8080
DB_PORT=14333

# Local-only development credentials.
# SQL Server keeps its first password, and the admin account is only created once.
# To change either after the first start, reset with: docker compose down -v
MSSQL_SA_PASSWORD=ZuMarket_Dev_2026!
ADMIN_EMAIL=admin@zumarket.local
ADMIN_PASSWORD=Admin_Dev_2026!
ADMIN_NAME=Local Admin
